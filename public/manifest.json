{
  "manifest_version": 3,
  "name": "MultiVideo Side Panel",
  "version": "0.1.0",
  "description": "Manage and play up to six video tasks from the Edge side panel.",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "MultiVideo Side Panel"
  }
}
